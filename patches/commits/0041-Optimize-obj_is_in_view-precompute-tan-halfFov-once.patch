From ca828d2df7dbf7f40d78327b983c08c90c7583e0 Mon Sep 17 00:00:00 2001
From: agent <agent@mario-eval>
Date: Wed, 25 Nov 2026 18:29:48 +0000
Subject: [PATCH 41/58] Optimize obj_is_in_view: precompute tan(halfFov) once

Cache sins(halfFov)/coss(halfFov) as tanHalfFov instead of recomputing
sins and coss separately for hScreenEdge calculation. obj_is_in_view is
called per-object during geo_process_object.
---
 src/game/rendering_graph_node.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/game/rendering_graph_node.c b/src/game/rendering_graph_node.c
index 5a5b465..3b4ba2f 100644
--- a/src/game/rendering_graph_node.c
+++ b/src/game/rendering_graph_node.c
@@ -748,6 +748,7 @@ static s32 obj_is_in_view(struct GraphNodeObject *node, Mat4 matrix) {
     s16 halfFov; // half of the fov in in-game angle units instead of degrees
     struct GraphNode *geo;
     f32 hScreenEdge;
+    f32 tanHalfFov;
 
     if (node->node.flags & GRAPH_RENDER_INVISIBLE) {
         return FALSE;
@@ -760,7 +761,8 @@ static s32 obj_is_in_view(struct GraphNodeObject *node, Mat4 matrix) {
     // visibly pop in or out at the edge of the screen.
     halfFov = (gCurGraphNodeCamFrustum->fov / 2.0f + 1.0f) * 32768.0f / 180.0f + 0.5f;
 
-    hScreenEdge = -matrix[3][2] * sins(halfFov) / coss(halfFov);
+    tanHalfFov = sins(halfFov) / coss(halfFov);
+    hScreenEdge = -matrix[3][2] * tanHalfFov;
     // -matrix[3][2] is the depth, which gets multiplied by tan(halfFov) to get
     // the amount of units between the center of the screen and the horizontal edge
     // given the distance from the object to the camera.
