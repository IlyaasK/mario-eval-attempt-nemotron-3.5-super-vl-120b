Subject: [PATCH 21/58] Milestone: GCC compiler + multiple files at -O3

---
 Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index 058b7d0..542ed52 100644
--- a/Makefile
+++ b/Makefile
@@ -751,9 +751,9 @@ ifeq ($(COMPILER),ido)
   $(BUILD_DIR)/src/game/rendering_graph_node.o: OPT_FLAGS := -O3
   $(BUILD_DIR)/src/engine/graph_node.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/engine/surface_collision.o: OPT_FLAGS := -O3
-  $(BUILD_DIR)/src/engine/math_util.o: OPT_FLAGS := -O2
+  $(BUILD_DIR)/src/engine/math_util.o: OPT_FLAGS := -O3
   $(BUILD_DIR)/src/game/obj_behaviors_2.o: OPT_FLAGS := -O3
-  $(BUILD_DIR)/src/game/object_helpers.o: OPT_FLAGS := -O2
+  $(BUILD_DIR)/src/game/object_helpers.o: OPT_FLAGS := -O3
   $(BUILD_DIR)/src/game/camera.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/engine/behavior_script.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/engine/behavior_script.o: OPT_FLAGS := -O3
@@ -767,7 +767,7 @@ ifeq ($(COMPILER),ido)
   $(BUILD_DIR)/src/audio/effects.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/audio/seqplayer.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/audio/external.o: OPT_FLAGS := -O2
-  $(BUILD_DIR)/src/engine/surface_collision.o: OPT_FLAGS := -O2
+  $(BUILD_DIR)/src/engine/surface_collision.o: OPT_FLAGS := -O3
   $(BUILD_DIR)/lib/src/math/ll%.o:   MIPSISET := -mips3 -32
   $(BUILD_DIR)/lib/src/ldiv.o:       OPT_FLAGS := -O2
   $(BUILD_DIR)/lib/src/string.o:     OPT_FLAGS := -O2
