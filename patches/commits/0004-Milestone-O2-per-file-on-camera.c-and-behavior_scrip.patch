From: agent <agent@mario-eval>
Date: Tue, 24 Nov 2026 22:42:47 +0000
Subject: [PATCH 04/58] Milestone: -O2 per-file on camera.c and
 behavior_script.c

cur_obj_update and camera paths compiled at -O2 under IDO. Console:
1.1501x under IDO, all gates pass.
---
 Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index f0fc622..1fdd743 100644
--- a/Makefile
+++ b/Makefile
@@ -751,8 +751,8 @@ ifeq ($(COMPILER),ido)
   $(BUILD_DIR)/src/game/rendering_graph_node.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/engine/math_util.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/src/game/object_helpers.o: OPT_FLAGS := -O2
-  $(BUILD_DIR)/lib/src/math/%.o:     OPT_FLAGS := -O2
-  $(BUILD_DIR)/lib/src/math/ll%.o:   OPT_FLAGS :=
+  $(BUILD_DIR)/src/game/camera.o: OPT_FLAGS := -O2
+  $(BUILD_DIR)/src/engine/behavior_script.o: OPT_FLAGS := -O2
   $(BUILD_DIR)/lib/src/math/ll%.o:   MIPSISET := -mips3 -32
   $(BUILD_DIR)/lib/src/ldiv.o:       OPT_FLAGS := -O2
   $(BUILD_DIR)/lib/src/string.o:     OPT_FLAGS := -O2
