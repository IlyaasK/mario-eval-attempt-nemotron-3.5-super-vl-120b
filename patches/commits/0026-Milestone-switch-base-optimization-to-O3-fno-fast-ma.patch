From 421ad315ec3d4632ce82db453dddd6c52bd2cd9a Mon Sep 17 00:00:00 2001
From: agent <agent@mario-eval>
Date: Wed, 25 Nov 2026 13:10:04 +0000
Subject: [PATCH 26/58] Milestone: switch base optimization to -O3
 -fno-fast-math

Console speedup: 1.4273x vs baseline 1.2622x (was 1.2672x with -O2).
All gates pass: vid% max 0.027% (limit 0.2%), memory footprint improved.
---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 12e7572..255c27c 100644
--- a/Makefile
+++ b/Makefile
@@ -112,7 +112,7 @@ ifeq      ($(COMPILER),ido)
 else ifeq ($(COMPILER),gcc)
   NON_MATCHING := 1
   MIPSISET     := -mips3
-  OPT_FLAGS    := -O2 -fno-fast-math
+  OPT_FLAGS    := -O3 -fno-fast-math
 endif
 
 
