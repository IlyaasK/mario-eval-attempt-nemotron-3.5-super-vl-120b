From 0d8cb5e6f35ce4e265ab3ac53fe191b63eac6c6c Mon Sep 17 00:00:00 2001
From: agent <agent@mario-eval>
Date: Wed, 25 Nov 2026 05:00:31 +0000
Subject: [PATCH 15/58] Milestone: Optimize mtxf_mul register pressure

Console: 1.2535x under IDO, all gates pass.
---
 src/engine/math_util.c | 45 ++++++++++++++++++++++--------------------
 1 file changed, 24 insertions(+), 21 deletions(-)

diff --git a/src/engine/math_util.c b/src/engine/math_util.c
index 91fd434..48628e2 100644
--- a/src/engine/math_util.c
+++ b/src/engine/math_util.c
@@ -489,33 +489,36 @@ void mtxf_align_terrain_triangle(Mat4 mtx, Vec3f pos, s16 yaw, f32 radius) {
  * then a.
  */
 void mtxf_mul(Mat4 dest, Mat4 a, Mat4 b) {
-    // Pre-load every element of both matrices into registers before any
-    // store, so the call is safe even when 'dest' aliases 'a' or 'b'.
-    register f32 a00 = a[0][0], a01 = a[0][1], a02 = a[0][2];
-    register f32 a10 = a[1][0], a11 = a[1][1], a12 = a[1][2];
-    register f32 a20 = a[2][0], a21 = a[2][1], a22 = a[2][2];
-    register f32 a30 = a[3][0], a31 = a[3][1], a32 = a[3][2];
-    register f32 b00 = b[0][0], b10 = b[1][0], b20 = b[2][0], b30 = b[3][0];
-    register f32 b01 = b[0][1], b11 = b[1][1], b21 = b[2][1], b31 = b[3][1];
-    register f32 b02 = b[0][2], b12 = b[1][2], b22 = b[2][2], b32 = b[3][2];
+    // Pre-load row 0 of 'a' into registers. Process one column of 'b' at a
+    // time to keep register pressure low and avoid spilling.
+    register f32 a00, a01, a02;
+    register f32 b00, b10, b20, b30;
+    register f32 b01, b11, b21, b31;
+    register f32 b02, b12, b22, b32;
 
-    // column 0 of dest
+    // Load all of b's columns (each column is reused by all rows of a).
+    b00 = b[0][0]; b10 = b[1][0]; b20 = b[2][0]; b30 = b[3][0];
+    b01 = b[0][1]; b11 = b[1][1]; b21 = b[2][1]; b31 = b[3][1];
+    b02 = b[0][2]; b12 = b[1][2]; b22 = b[2][2]; b32 = b[3][2];
+
+    // Load row 0 of a and process column 0 of dest.
+    a00 = a[0][0]; a01 = a[0][1]; a02 = a[0][2];
     dest[0][0] = a00 * b00 + a01 * b10 + a02 * b20;
-    dest[1][0] = a10 * b00 + a11 * b10 + a12 * b20;
-    dest[2][0] = a20 * b00 + a21 * b10 + a22 * b20;
-    dest[3][0] = a30 * b00 + a31 * b10 + a32 * b20 + b30;
+    dest[1][0] = a[1][0] * b00 + a[1][1] * b10 + a[1][2] * b20;
+    dest[2][0] = a[2][0] * b00 + a[2][1] * b10 + a[2][2] * b20;
+    dest[3][0] = a[3][0] * b00 + a[3][1] * b10 + a[3][2] * b20 + b30;
 
-    // column 1 of dest
+    // Process column 1 of dest.
     dest[0][1] = a00 * b01 + a01 * b11 + a02 * b21;
-    dest[1][1] = a10 * b01 + a11 * b11 + a12 * b21;
-    dest[2][1] = a20 * b01 + a21 * b11 + a22 * b21;
-    dest[3][1] = a30 * b01 + a31 * b11 + a32 * b21 + b31;
+    dest[1][1] = a[1][0] * b01 + a[1][1] * b11 + a[1][2] * b21;
+    dest[2][1] = a[2][0] * b01 + a[2][1] * b11 + a[2][2] * b21;
+    dest[3][1] = a[3][0] * b01 + a[3][1] * b11 + a[3][2] * b21 + b31;
 
-    // column 2 of dest
+    // Process column 2 of dest.
     dest[0][2] = a00 * b02 + a01 * b12 + a02 * b22;
-    dest[1][2] = a10 * b02 + a11 * b12 + a12 * b22;
-    dest[2][2] = a20 * b02 + a21 * b12 + a22 * b22;
-    dest[3][2] = a30 * b02 + a31 * b12 + a32 * b22 + b32;
+    dest[1][2] = a[1][0] * b02 + a[1][1] * b12 + a[1][2] * b22;
+    dest[2][2] = a[2][0] * b02 + a[2][1] * b12 + a[2][2] * b22;
+    dest[3][2] = a[3][0] * b02 + a[3][1] * b12 + a[3][2] * b22 + b32;
 
     dest[0][3] = dest[1][3] = dest[2][3] = 0;
     dest[3][3] = 1;
-- 
